rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // Core Helper Functions (Single-Enterprise Identity Boundary)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Single-enterprise isolation: Reject any foreign tenant context
    function isEnterpriseScope() {
      return !('tenantId' in request.auth.token) || request.auth.token.tenantId == 'nexus-enterprise';
    }

    // Role resolution: Custom Claims take precedence; authoritative staff profile is secondary
    function hasClaimRole(roleName) {
      return isEnterpriseScope() && (
        ('role' in request.auth.token && request.auth.token.role == roleName) || 
        ('roles' in request.auth.token && request.auth.token.roles is list && roleName in request.auth.token.roles)
      );
    }

    function getStaffRole() {
      return !isEnterpriseScope() ? null :
        (('role' in request.auth.token && request.auth.token.role != null)
          ? request.auth.token.role
          : (exists(/databases/$(database)/documents/staff/$(request.auth.uid))
              ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role
              : null));
    }

    function isStaff() {
      return isAuthenticated() && isEnterpriseScope() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('isSuperAdmin' in request.auth.token && request.auth.token.isSuperAdmin == true) ||
        ('role' in request.auth.token && request.auth.token.role in [
          'Super Admin', 'Business Owner', 'Store Manager', 'Admin', 'Manager',
          'Inventory Manager', 'Warehouse Manager', 'Purchasing Officer',
          'Cashier', 'Sales Associate', 'Sales Manager', 'Accountant',
          'E-commerce Manager', 'Warehouse Staff'
        ]) ||
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in [
           'Super Admin', 'Business Owner', 'Store Manager', 'Admin', 'Manager',
           'Inventory Manager', 'Warehouse Manager', 'Purchasing Officer',
           'Cashier', 'Sales Associate', 'Sales Manager', 'Accountant',
           'E-commerce Manager', 'Warehouse Staff'
         ])
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && isEnterpriseScope() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('isSuperAdmin' in request.auth.token && request.auth.token.isSuperAdmin == true) ||
        hasClaimRole('Super Admin') ||
        getStaffRole() == 'Super Admin'
      );
    }

    function isManagerOrAdmin() {
      return isAuthenticated() && isEnterpriseScope() && (
        isSuperAdmin() ||
        hasClaimRole('Business Owner') ||
        hasClaimRole('Store Manager') ||
        hasClaimRole('Admin') ||
        hasClaimRole('Manager') ||
        getStaffRole() in ['Business Owner', 'Store Manager', 'Admin', 'Manager']
      );
    }

    function isInventoryStaff() {
      return isAuthenticated() && isEnterpriseScope() && (
        isManagerOrAdmin() ||
        hasClaimRole('Inventory Manager') ||
        hasClaimRole('Warehouse Manager') ||
        hasClaimRole('Purchasing Officer') ||
        getStaffRole() in ['Inventory Manager', 'Warehouse Manager', 'Purchasing Officer']
      );
    }

    function isSalesStaff() {
      return isAuthenticated() && isEnterpriseScope() && (
        isManagerOrAdmin() ||
        hasClaimRole('Cashier') ||
        hasClaimRole('Sales Associate') ||
        hasClaimRole('Sales Manager') ||
        getStaffRole() in ['Cashier', 'Sales Associate', 'Sales Manager']
      );
    }

    function hasAnyStaffRole() {
      return isStaff();
    }

    function hasPermission(perm) {
      return isSuperAdmin() ||
        (isAuthenticated() && isEnterpriseScope() && 'permissions' in request.auth.token && request.auth.token.permissions is list && perm in request.auth.token.permissions);
    }

    // ==========================================
    // Entity Schema Validation Functions
    // ==========================================
    // Internal Product Schema (Contains cost, supplier info, inventory rules)
    function isValidProduct(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.category is string && data.category.size() <= 100;
    }

    // Public Product Projection Schema (Safe for public storefront; STRICTLY excludes sensitive cost/supplier fields)
    function isValidPublicProduct(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.category is string && data.category.size() <= 100 &&
             // Sensitive fields MUST NOT exist in public projection
             !('cost' in data) &&
             !('costPrice' in data) &&
             !('reorderPoint' in data) &&
             !('serialNumbers' in data) &&
             !('supplier' in data) &&
             !('batchNumber' in data);
    }

    function isValidCustomer(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             (!('loyaltyPoints' in data) || (data.loyaltyPoints is number && data.loyaltyPoints >= 0));
    }

    function isValidStaff(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.role is string &&
             data.status is string && data.status in ['Active', 'Inactive', 'On Leave'] &&
             // PIN is optional on staff document to support credential segregation
             (!('pin' in data) || (data.pin is string && data.pin.size() >= 4 && data.pin.size() <= 8));
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.date is string && data.date.size() > 0 &&
             data.subtotal is number && data.subtotal >= 0 &&
             data.total is number && data.total >= 0 &&
             data.channel is string && data.channel in ['pos', 'ecom', 'mobile', 'phone'] &&
             data.status is string && data.status in ['Completed', 'Pending', 'Processing', 'Cancelled', 'Refunded'];
    }

    // Untrusted Client Input Boundary for Public E-commerce Orders
    function isValidEcomOrder(data) {
      return data.channel == 'ecom' &&
             // Browser-created e-commerce orders MUST be initialized as Pending. Client cannot set Completed or Paid!
             data.status == 'Pending' &&
             (!('paymentStatus' in data) || data.paymentStatus in ['Pending', 'Unpaid']) &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 150 &&
             data.customerEmail is string && data.customerEmail.size() > 0 && data.customerEmail.size() <= 150 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.total is number && data.total >= 0;
    }

    function isValidAuditLog(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.timestamp is string && data.timestamp.size() > 0 &&
             data.staffName is string && data.staffName.size() > 0 && data.staffName.size() <= 150 &&
             data.action is string && data.action.size() > 0 && data.action.size() <= 100 &&
             data.module is string && data.module.size() > 0 && data.module.size() <= 50 &&
             data.details is string && data.details.size() <= 2000;
    }

    function isValidSettings(data) {
      return data.currency is string && data.currency.size() <= 10 &&
             data.businessName is string && data.businessName.size() > 0 && data.businessName.size() <= 200 &&
             data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 100;
    }

    // Public Settings Projection Schema (Safe for public storefront; STRICTLY excludes supervisor PINs, printer/network configs, webhooks, security/integration secrets)
    function isValidPublicSettings(data) {
      return data.businessName is string && data.businessName.size() > 0 && data.businessName.size() <= 200 &&
             data.currency is string && data.currency.size() <= 10 &&
             data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 100 &&
             // Sensitive internal fields MUST NOT exist in public settings
             !('supervisorPin' in data) &&
             !('pin' in data) &&
             !('secret' in data) &&
             !('secrets' in data) &&
             !('apiKey' in data) &&
             !('apiKeys' in data) &&
             !('webhookUrl' in data) &&
             !('webhookUrls' in data) &&
             !('printerSettings' in data) &&
             !('networkSettings' in data) &&
             !('securitySettings' in data) &&
             !('notificationSettings' in data) &&
             !('operationalConfig' in data) &&
             !('credentials' in data);
    }

    // Constrained guest e-commerce customer creation (strictly requires ecom_guest channel, prohibits loyalty points manipulation)
    function isValidGuestCustomer(data) {
      return ('channel' in data && data.channel == 'ecom_guest') &&
             (!('loyaltyPoints' in data) || data.loyaltyPoints == 0);
    }

    function isValidShiftReport(data) {
      return data.reportId is string && data.reportId.size() > 0 && data.reportId.size() <= 128 &&
             data.terminalId is string && data.terminalId.size() > 0 && data.terminalId.size() <= 100 &&
             data.staffName is string && data.staffName.size() > 0 && data.staffName.size() <= 150 &&
             data.shiftStartTime is string && data.shiftStartTime.size() > 0 &&
             data.totalSales is number && data.totalSales >= 0;
    }

    // ==========================================
    // 1. Default Deny Global Boundary
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 2. Products Collection (Internal - Sensitive)
    // ==========================================
    // Staff-only access: Contains cost price, supplier information, and inventory rules.
    // Public unauthenticated users are strictly blocked.
    match /products/{productId} {
      allow read: if isStaff();
      allow create: if isValidId(productId) && isInventoryStaff() && isValidProduct(incoming());
      allow update: if isValidId(productId) && isInventoryStaff() && isValidProduct(incoming());
      allow delete: if isValidId(productId) && isManagerOrAdmin();
    }

    // ==========================================
    // 3. Public Products Projection Collection (Storefront Safe)
    // ==========================================
    // Public read for customer storefront; cost prices, suppliers, and internal fields omitted.
    match /public_products/{productId} {
      allow read: if true;
      allow create: if isValidId(productId) && isInventoryStaff() && isValidPublicProduct(incoming());
      allow update: if isValidId(productId) && isInventoryStaff() && isValidPublicProduct(incoming());
      allow delete: if isValidId(productId) && isManagerOrAdmin();
    }

    // ==========================================
    // 4. Customers Collection (CRM Directory)
    // ==========================================
    // Protected CRM: Sales staff can query directory; customers can read/update own record only.
    // Anonymous customer creation is strictly restricted to constrained guest e-commerce flow.
    match /customers/{customerId} {
      allow get: if isValidId(customerId) && (
        isSalesStaff() || 
        (isAuthenticated() && (request.auth.uid == customerId || (resource.data != null && 'email' in resource.data && 'email' in request.auth.token && resource.data.email == request.auth.token.email)))
      );
      allow list: if isSalesStaff();
      allow create: if isValidId(customerId) && isValidCustomer(incoming()) && (
        isSalesStaff() || 
        (isAuthenticated() && request.auth.uid == customerId) || 
        isValidGuestCustomer(incoming())
      );
      allow update: if isValidId(customerId) && isValidCustomer(incoming()) && (
        isSalesStaff() || 
        (isAuthenticated() && request.auth.uid == customerId)
      );
      allow delete: if isValidId(customerId) && isManagerOrAdmin();
    }

    // ==========================================
    // 5. Staff Collection & Credentials Vault
    // ==========================================
    // Strictly authenticated staff directory access.
    match /staff/{staffId} {
      allow get, list: if isAuthenticated() && hasAnyStaffRole();
      allow create: if isValidId(staffId) && isManagerOrAdmin() && isValidStaff(incoming());
      allow update: if isValidId(staffId) && isValidStaff(incoming()) && (
        isManagerOrAdmin() || 
        (request.auth.uid == staffId && incoming().diff(existing()).affectedKeys().hasOnly(['avatar', 'phone', 'lastActive']))
      );
      allow delete: if isValidId(staffId) && isSuperAdmin();
    }

    // Protected Credentials Vault: Isolated credential records, STRICTLY client-inaccessible.
    // Client SDKs (even Super Admin browser sessions) CANNOT read or write this collection.
    // Management is strictly restricted to trusted server runtimes / Firebase Admin SDK.
    match /staff_credentials/{staffId} {
      allow read, write: if false;
    }

    // ==========================================
    // 6. Orders Collection
    // ==========================================
    // Sales staff can list all orders.
    // Customers can ONLY list their own orders (enforces customerId scoping) and retrieve own order.
    // Public visitors can only create valid untrusted e-commerce orders (Pending status).
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isSalesStaff() || 
        (isAuthenticated() && resource.data.customerId == request.auth.uid)
      );
      allow list: if isSalesStaff() || (
        isAuthenticated() && 
        resource.data.customerId == request.auth.uid
      );
      allow create: if isValidId(orderId) && isValidOrder(incoming()) && (
        (incoming().channel == 'pos' && isSalesStaff()) || 
        (incoming().channel == 'ecom' && isValidEcomOrder(incoming()))
      );
      allow update: if isValidId(orderId) && isSalesStaff() && isValidOrder(incoming());
      allow delete: if isValidId(orderId) && isSuperAdmin();
    }

    // ==========================================
    // 7. Audit Logs Collection
    // ==========================================
    // Strictly append-only immutable ledger; read restricted to manager/auditors.
    match /audit_logs/{logId} {
      allow get, list: if isManagerOrAdmin();
      allow create: if isValidId(logId) && isAuthenticated() && isStaff() && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    // ==========================================
    // 8. Internal System Settings Collection (Staff Only)
    // ==========================================
    // Internal settings containing supervisor PINs, integrations, printer/network, operational configs.
    // Public unauthenticated access is strictly blocked.
    match /settings/{settingId} {
      allow read: if isStaff();
      allow create, update: if isValidId(settingId) && isManagerOrAdmin() && isValidSettings(incoming());
      allow delete: if false;
    }

    // ==========================================
    // 9. Public Settings Projection Collection (Storefront Safe)
    // ==========================================
    // Public read for customer storefront (business name, currency, tax rate); internal configs omitted.
    match /public_settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && isManagerOrAdmin() && isValidPublicSettings(incoming());
      allow delete: if false;
    }

    // ==========================================
    // 10. Shift Reports Collection
    // ==========================================
    // Cashier float reconciliation & Z-reports; permanent financial records (no deletion).
    match /shift_reports/{shiftId} {
      allow get, list: if isSalesStaff() || isManagerOrAdmin();
      allow create: if isValidId(shiftId) && (isSalesStaff() || isManagerOrAdmin()) && isValidShiftReport(incoming());
      allow update: if isValidId(shiftId) && isManagerOrAdmin() && isValidShiftReport(incoming());
      allow delete: if false;
    }

    // ==========================================
    // 11. Diagnostic Test Connection Document
    // ==========================================
    match /test/{testId} {
      allow read: if isValidId(testId);
      allow write: if false;
    }
  }
}
