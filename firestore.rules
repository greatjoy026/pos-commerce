rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isEnterpriseScope() { return !('tenantId' in request.auth.token) || request.auth.token.tenantId == 'nexus-enterprise'; }
    function hasClaimRole(roleName) {
      return isEnterpriseScope() && (
        ('role' in request.auth.token && request.auth.token.role == roleName) ||
        ('roles' in request.auth.token && request.auth.token.roles is list && roleName in request.auth.token.roles)
      );
    }
    function getStaffRole() {
      return !isEnterpriseScope() ? null :
        (('role' in request.auth.token && request.auth.token.role != null)
          ? request.auth.token.role
          : (exists(/databases/$(database)/documents/staff/$(request.auth.uid))
              ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role
              : null));
    }
    function isStaff() {
      return isAuthenticated() && isEnterpriseScope() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('isSuperAdmin' in request.auth.token && request.auth.token.isSuperAdmin == true) ||
        ('role' in request.auth.token && request.auth.token.role in [
          'Super Admin', 'Business Owner', 'Store Manager', 'Admin', 'Manager',
          'Inventory Manager', 'Warehouse Manager', 'Purchasing Officer',
          'Cashier', 'Sales Associate', 'Sales Manager', 'Accountant',
          'E-commerce Manager', 'Warehouse Staff'
        ]) ||
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in [
          'Super Admin', 'Business Owner', 'Store Manager', 'Admin', 'Manager',
          'Inventory Manager', 'Warehouse Manager', 'Purchasing Officer',
          'Cashier', 'Sales Associate', 'Sales Manager', 'Accountant',
          'E-commerce Manager', 'Warehouse Staff'
        ])
      );
    }
    function isSuperAdmin() {
      return isAuthenticated() && isEnterpriseScope() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('isSuperAdmin' in request.auth.token && request.auth.token.isSuperAdmin == true) ||
        hasClaimRole('Super Admin') || getStaffRole() == 'Super Admin'
      );
    }
    function isManagerOrAdmin() {
      return isAuthenticated() && isEnterpriseScope() && (
        isSuperAdmin() || hasClaimRole('Business Owner') || hasClaimRole('Store Manager') ||
        hasClaimRole('Admin') || hasClaimRole('Manager') ||
        getStaffRole() in ['Business Owner', 'Store Manager', 'Admin', 'Manager']
      );
    }
    function isInventoryStaff() {
      return isAuthenticated() && isEnterpriseScope() && (
        isManagerOrAdmin() || hasClaimRole('Inventory Manager') || hasClaimRole('Warehouse Manager') ||
        hasClaimRole('Purchasing Officer') ||
        getStaffRole() in ['Inventory Manager', 'Warehouse Manager', 'Purchasing Officer']
      );
    }
    function isSalesStaff() {
      return isAuthenticated() && isEnterpriseScope() && (
        isManagerOrAdmin() || hasClaimRole('Cashier') || hasClaimRole('Sales Associate') ||
        hasClaimRole('Sales Manager') || getStaffRole() in ['Cashier', 'Sales Associate', 'Sales Manager']
      );
    }
    function hasAnyStaffRole() { return isStaff(); }

    function isValidProduct(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100 &&
        data.price is number && data.price >= 0 && data.stock is number && data.stock >= 0 &&
        data.category is string && data.category.size() <= 100;
    }
    function isValidPublicProduct(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100 &&
        data.price is number && data.price >= 0 && data.category is string && data.category.size() <= 100 &&
        ('availability' in data) && data.availability is map && ('status' in data.availability) &&
        data.availability.status is string && data.availability.status in ['IN_STOCK', 'LOW_STOCK', 'OUT_OF_STOCK'] &&
        !('stock' in data) && !('cost' in data) && !('costPrice' in data) && !('reorderPoint' in data) &&
        !('serialNumbers' in data) && !('supplier' in data) && !('batchNumber' in data);
    }
    function isValidPublicVariant(data) {
      return data is map && data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100 &&
        ('availability' in data) && data.availability is map && ('status' in data.availability) &&
        data.availability.status is string && data.availability.status in ['IN_STOCK', 'LOW_STOCK', 'OUT_OF_STOCK'] &&
        !('stock' in data) && !('costPrice' in data);
    }
    function isValidCustomer(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
        (!('loyaltyPoints' in data) || (data.loyaltyPoints is number && data.loyaltyPoints >= 0));
    }
    function isValidStaff(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
        data.role is string && data.status is string && data.status in ['Active', 'Inactive', 'On Leave'] &&
        (!('pin' in data) || (data.pin is string && data.pin.size() >= 4 && data.pin.size() <= 8));
    }
    function isValidOrder(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.date is string && data.date.size() > 0 && data.subtotal is number && data.subtotal >= 0 &&
        data.total is number && data.total >= 0 && data.channel is string &&
        data.channel in ['pos', 'ecom', 'mobile', 'phone'] && data.status is string &&
        data.status in ['Completed', 'Pending', 'Processing', 'Cancelled', 'Refunded'];
    }
    function isValidEcomOrder(data) {
      return data.channel == 'ecom' && data.status == 'Pending' &&
        (!('paymentStatus' in data) || data.paymentStatus in ['Pending', 'Unpaid']) &&
        data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 150 &&
        data.customerEmail is string && data.customerEmail.size() > 0 && data.customerEmail.size() <= 150 &&
        data.items is list && data.items.size() > 0 && data.items.size() <= 100 && data.total is number && data.total >= 0;
    }
    function isValidAuditLog(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 && data.timestamp is string &&
        data.timestamp.size() > 0 && data.staffName is string && data.staffName.size() > 0 && data.staffName.size() <= 150 &&
        data.action is string && data.action.size() > 0 && data.action.size() <= 100 && data.module is string &&
        data.module.size() > 0 && data.module.size() <= 50 && data.details is string && data.details.size() <= 2000;
    }
    function isValidSettings(data) {
      return data.currency is string && data.currency.size() <= 10 && data.businessName is string &&
        data.businessName.size() > 0 && data.businessName.size() <= 200 && data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 100;
    }
    function isValidPublicSettings(data) {
      return data.businessName is string && data.businessName.size() > 0 && data.businessName.size() <= 200 &&
        data.currency is string && data.currency.size() <= 10 && data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 100 &&
        !('supervisorPin' in data) && !('pin' in data) && !('secret' in data) && !('secrets' in data) &&
        !('apiKey' in data) && !('apiKeys' in data) && !('webhookUrl' in data) && !('webhookUrls' in data) &&
        !('printerSettings' in data) && !('networkSettings' in data) && !('securitySettings' in data) &&
        !('notificationSettings' in data) && !('operationalConfig' in data) && !('credentials' in data);
    }
    function isValidGuestCustomer(data) {
      return ('channel' in data && data.channel == 'ecom_guest') && (!('loyaltyPoints' in data) || data.loyaltyPoints == 0);
    }
    function isValidShiftReport(data) {
      return data.reportId is string && data.reportId.size() > 0 && data.reportId.size() <= 128 &&
        data.terminalId is string && data.terminalId.size() > 0 && data.terminalId.size() <= 100 &&
        data.staffName is string && data.staffName.size() > 0 && data.staffName.size() <= 150 &&
        data.shiftStartTime is string && data.shiftStartTime.size() > 0 && data.totalSales is number && data.totalSales >= 0;
    }

    function isValidInventoryRecord(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100 &&
        data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128 &&
        (!('variantId' in data) || (data.variantId is string && data.variantId.size() > 0 && data.variantId.size() <= 128)) &&
        data.locationId is string && data.locationId.size() > 0 && data.locationId.size() <= 100 &&
        data.quantityOnHand is int && data.quantityOnHand >= 0 && data.quantityReserved is int && data.quantityReserved >= 0 &&
        data.quantityReserved <= data.quantityOnHand && data.trackingMode is string && data.trackingMode in ['QUANTITY', 'SERIAL', 'BATCH', 'NONE'] &&
        data.status is string && data.status in ['ACTIVE', 'INACTIVE'] && ('createdAt' in data) && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 60 &&
        ('updatedAt' in data) && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 60 &&
        (!('reorderPoint' in data) || (data.reorderPoint is int && data.reorderPoint >= 0)) &&
        (!('reorderQuantity' in data) || (data.reorderQuantity is int && data.reorderQuantity >= 0)) &&
        (data.trackingMode == 'NONE' ?
          (data.quantityOnHand == 0 && data.quantityReserved == 0 && !('serialNumbers' in data) && !('batchNumber' in data) && !('expiryDate' in data)) :
         data.trackingMode == 'QUANTITY' ?
          (!('serialNumbers' in data) && !('batchNumber' in data) && !('expiryDate' in data)) :
         data.trackingMode == 'SERIAL' ?
          (!('batchNumber' in data) && !('expiryDate' in data) && ('serialNumbers' in data) && data.serialNumbers is list &&
           data.serialNumbers.size() == data.quantityOnHand && data.serialNumbers.toSet().size() == data.serialNumbers.size() &&
           !data.serialNumbers.hasAny(['']) && (data.serialNumbers.size() == 0 ||
            (data.serialNumbers[0] is string && data.serialNumbers[0].size() > 0 && data.serialNumbers[0].size() <= 100 &&
             data.serialNumbers[data.serialNumbers.size() - 1] is string && data.serialNumbers[data.serialNumbers.size() - 1].size() > 0 && data.serialNumbers[data.serialNumbers.size() - 1].size() <= 100))) :
         data.trackingMode == 'BATCH' ?
          (!('serialNumbers' in data) && ('batchNumber' in data) && data.batchNumber is string && data.batchNumber.size() > 0 && data.batchNumber.size() <= 100 &&
           (!('expiryDate' in data) || (data.expiryDate is string && data.expiryDate.size() >= 10 && data.expiryDate.size() <= 40))) : false);
    }

    function isValidMovement(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.inventoryId is string && data.inventoryId.size() > 0 && data.inventoryId.size() <= 128 &&
        data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100 &&
        data.locationId is string && data.locationId.size() > 0 && data.locationId.size() <= 100 &&
        data.movementType is string && data.movementType in ['PURCHASE_RECEIPT', 'SALE', 'RETURN', 'ADJUSTMENT', 'TRANSFER'] &&
        data.quantityDelta is int && data.quantityDelta != 0 && data.quantityBefore is int && data.quantityBefore >= 0 &&
        data.quantityAfter is int && data.quantityAfter >= 0 && data.quantityAfter == data.quantityBefore + data.quantityDelta &&
        data.performedBy is string && data.performedBy == request.auth.uid && data.timestamp is string && data.timestamp.size() >= 10 && data.timestamp.size() <= 60 &&
        (!('referenceId' in data) || (data.referenceId is string && data.referenceId.size() > 0 && data.referenceId.size() <= 128)) &&
        (!('reason' in data) || (data.reason is string && data.reason.size() > 0 && data.reason.size() <= 1000));
    }

    match /{document=**} { allow read, write: if false; }

    match /products/{productId} {
      allow read: if isStaff();
      allow create: if isValidId(productId) && isInventoryStaff() && isValidProduct(incoming());
      allow update: if isValidId(productId) && isInventoryStaff() && isValidProduct(incoming());
      allow delete: if isValidId(productId) && isManagerOrAdmin();
    }

    match /inventory/{inventoryId} {
      allow read: if isStaff();
      allow create: if isValidId(inventoryId) && isInventoryStaff() && isValidInventoryRecord(incoming());
      // Direct balance writes remain restricted to inventory-authorized staff during this migration phase.
      // INV-002 movement service is the application-level authoritative mutation path.
      allow update: if isValidId(inventoryId) && isInventoryStaff() && isValidInventoryRecord(incoming());
      allow delete: if isValidId(inventoryId) && isManagerOrAdmin();
    }

    match /inventory_movements/{movementId} {
      allow get, list: if isStaff();
      allow create: if isValidId(movementId) && isInventoryStaff() && isValidMovement(incoming());
      allow update, delete: if false;
    }

    match /public_products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isInventoryStaff() && isValidPublicProduct(incoming());
      allow delete: if isValidId(productId) && isManagerOrAdmin();
      match /variants/{variantId} {
        allow read: if true;
        allow create, update: if isValidId(variantId) && isInventoryStaff() && isValidPublicVariant(incoming());
        allow delete: if isValidId(variantId) && isManagerOrAdmin();
      }
    }

    match /customers/{customerId} {
      allow get: if isValidId(customerId) && (isSalesStaff() || (isAuthenticated() && (request.auth.uid == customerId || (resource.data != null && 'email' in resource.data && 'email' in request.auth.token && resource.data.email == request.auth.token.email))));
      allow list: if isSalesStaff();
      allow create: if isValidId(customerId) && isValidCustomer(incoming()) && (isSalesStaff() || (isAuthenticated() && request.auth.uid == customerId) || isValidGuestCustomer(incoming()));
      allow update: if isValidId(customerId) && isValidCustomer(incoming()) && (isSalesStaff() || (isAuthenticated() && request.auth.uid == customerId));
      allow delete: if isValidId(customerId) && isManagerOrAdmin();
    }

    match /staff/{staffId} {
      allow get, list: if isAuthenticated() && hasAnyStaffRole();
      allow create: if isValidId(staffId) && isManagerOrAdmin() && isValidStaff(incoming());
      allow update: if isValidId(staffId) && isValidStaff(incoming()) && (isManagerOrAdmin() || (request.auth.uid == staffId && incoming().diff(existing()).affectedKeys().hasOnly(['avatar', 'phone', 'lastActive'])));
      allow delete: if isValidId(staffId) && isSuperAdmin();
    }
    match /staff_credentials/{staffId} { allow read, write: if false; }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isSalesStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid));
      allow list: if isSalesStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isValidId(orderId) && isValidOrder(incoming()) && ((incoming().channel == 'pos' && isSalesStaff()) || (incoming().channel == 'ecom' && isValidEcomOrder(incoming())));
      allow update: if isValidId(orderId) && isSalesStaff() && isValidOrder(incoming());
      allow delete: if isValidId(orderId) && isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow get, list: if isManagerOrAdmin();
      allow create: if isValidId(logId) && isAuthenticated() && isStaff() && isValidAuditLog(incoming());
      allow update, delete: if false;
    }
    match /settings/{settingId} {
      allow read: if isStaff();
      allow create, update: if isValidId(settingId) && isManagerOrAdmin() && isValidSettings(incoming());
      allow delete: if false;
    }
    match /public_settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && isManagerOrAdmin() && isValidPublicSettings(incoming());
      allow delete: if false;
    }
    match /shift_reports/{shiftId} {
      allow get, list: if isSalesStaff() || isManagerOrAdmin();
      allow create: if isValidId(shiftId) && (isSalesStaff() || isManagerOrAdmin()) && isValidShiftReport(incoming());
      allow update: if isValidId(shiftId) && isManagerOrAdmin() && isValidShiftReport(incoming());
      allow delete: if false;
    }
    match /test/{testId} { allow read: if isValidId(testId); allow write: if false; }
  }
}
